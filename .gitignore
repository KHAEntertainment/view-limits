node_modules/
*.log
.DS_Store
.reticle/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Traycer agent working state — per-session ids, dev-state, and sprint drafts
# superseded by the shipped code and ~/.traycer/epics artifacts.
/.agent/

# gh-init orchestration environment — local repo/board/milestone cache (env.json).
# Scoped to this one file, NOT the whole .pi/ directory, so other .pi/ config
# stays committable.
/.pi/github-workflows/env.json

