{
  "description": "Optional coding-plan dispatch gate and SessionStart cache refresh, both off by default. The gate reads cached status synchronously (never network); deny mode blocks only a fresh, unambiguous exhausted route. The session-start notice stays enabled.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task|mcp__traycer_a2a__traycer_create_agent|mcp__traycer_a2a__traycer_configure_agent|mcp__traycer_a2a__traycer_fork_agent",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/vl.js", "gate"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/vl.js", "refresh", "--quiet", "--session-start"],
            "async": true,
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/vl.js", "session-start"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
